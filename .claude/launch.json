{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:create_app", "--factory", "--port", "8000", "--app-dir", "backend"],
      "port": 8000
    },
    {
      "name": "backend-verify",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:create_app", "--factory", "--port", "8001", "--app-dir", "backend"],
      "port": 8001
    }
  ]
}
